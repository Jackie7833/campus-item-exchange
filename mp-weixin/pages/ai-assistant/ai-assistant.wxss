.page{min-height:100vh;background:#f4f7fb;padding:24rpx;box-sizing:border-box}.hero{padding:28rpx 8rpx 20rpx}.hero-title{font-size:40rpx;font-weight:700;color:#102a43;line-height:1.4}.hero-subtitle{font-size:26rpx;color:#526579;line-height:1.6;margin-top:8rpx}.tabs{display:flex;gap:12rpx;margin:10rpx 0 20rpx}.tab{flex:1;text-align:center;font-size:26rpx;line-height:64rpx;border-radius:10rpx;background:#e8eef5;color:#526579}.tab.active{background:#102a43;color:#fff}.panel,.result{background:#fff;border-radius:12rpx;padding:24rpx;margin-top:20rpx}.input{width:100%;min-height:180rpx;border:2rpx solid #dde6f0;border-radius:10rpx;padding:18rpx;box-sizing:border-box;font-size:28rpx;line-height:1.6;background:#fbfdff}.primary{margin-top:20rpx;background:#1f7a8c;color:#fff;border-radius:12rpx;font-size:28rpx;line-height:76rpx}.result-title{font-size:30rpx;font-weight:700;color:#102a43;margin-bottom:16rpx}.item{padding:20rpx;border:2rpx solid #e6eef7;border-radius:10rpx;margin-bottom:16rpx;background:#fbfdff}.item-title{font-size:30rpx;font-weight:700;color:#102a43;line-height:1.5}.item-meta{font-size:24rpx;color:#62758a;line-height:1.6;margin-top:4rpx}.item-reason{font-size:24rpx;color:#34495e;line-height:1.7;margin-top:6rpx}.empty{font-size:26rpx;color:#7a8796;line-height:1.7;padding:20rpx 0}