@charset "UTF-8";page{--animate-duration:1s;--animate-delay:1s;--animate-repeat:1}.content{min-height:calc(100vh - 44px);box-sizing:border-box}.seat-list{display:flex;align-items:center;flex-wrap:wrap;background:#FFFFFF;margin:20rpx;border-radius:20rpx;padding:20rpx;font-size:30rpx}.seat-list .seat-item{width:33.33%;display:flex;align-items:center;flex-direction:column;margin-bottom:20rpx}.seat-list .seat-item .seat-icon{width:50rpx;height:50rpx;margin-bottom:10rpx}audio{display:flex;flex-direction:column}.audio .uni-audio-default{width:inherit}.container{background:#f6f8fa !important}.swiper,.swiper swiper-item{height:420rpx !important;background:#f3f7f8 !important}.swiper image{height:420rpx !important;object-fit:contain !important;background:#f3f7f8 !important}.detail-content{padding:24rpx !important}.detail-list-item{margin:0 0 2rpx !important;padding:8rpx 20rpx !important;border:0 !important;background:#fff !important}.detail-list-item:first-child{border-radius:18rpx 18rpx 0 0 !important}.detail-list-item .lable{width:180rpx !important;padding-right:24rpx !important;text-align:left !important;color:#63717c !important}.detail-list-item .text{flex:1 !important;line-height:44rpx !important;padding:18rpx 0 !important;color:#12202b !important;word-break:break-all !important}.detail-list-item.rich{margin-top:18rpx !important;border-radius:18rpx !important;display:block !important}.detail-list-item.rich .lable{width:100% !important;line-height:56rpx !important;font-weight:600 !important}.rich-text{padding:12rpx 0 20rpx !important;line-height:44rpx !important;color:#26323d !important}.comoment-header,.comment-item{border-radius:18rpx !important;background:#fff !important;box-shadow:0 10rpx 30rpx rgba(24,35,47,.07) !important;overflow:hidden !important}.btn-comment-content,.bottom-content button,.cu-btn{border-radius:14rpx !important;background:#12b3a8 !important}